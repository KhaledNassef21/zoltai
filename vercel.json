{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/blog/make-3000-month-with-ai-voice-services-elevenlabs-murf-guide-2024",
      "destination": "/blog/top-ai-voice-tools-elevenlabs-murf-ai",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "https://zoltai.org/",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "zoltai.vercel.app"
        }
      ]
    },
    {
      "source": "/:path*",
      "destination": "https://zoltai.org/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "zoltai.vercel.app"
        }
      ]
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ],
      "has": [
        {
          "type": "host",
          "value": "zoltai.org"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ],
      "has": [
        {
          "type": "host",
          "value": "zoltai.vercel.app"
        }
      ]
    }
  ]
}
